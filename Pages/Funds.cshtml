@page
@model BetfairReplicator.Pages.FundsModel
@{
    ViewData["Title"] = "Saldo";

    var totalBalance = Model.Rows.Where(r => r.IsConnected).Sum(r => r.AvailableToBetBalance ?? 0);
    var totalStake = Model.Rows.Where(r => r.IsConnected).Sum(r => r.StakePreview ?? 0);
    var totalExposure = Model.Rows.Where(r => r.IsConnected).Sum(r => r.Exposure ?? 0);
    var connectedCount = Model.Rows.Count(r => r.IsConnected);
    var errorCount = Model.Rows.Count(r => !r.IsConnected);
}

<div class="ns-page">

    <!-- ═══ HEADER ═══════════════════════════════════════════════════════ -->
    <div class="ns-header-card">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="ns-title h4 mb-1">Saldo account</h1>
                <div class="ns-subtitle">
                    Fondi disponibili · stake preview · esposizione
                </div>
            </div>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Index">Home</a>
        </div>
    </div>

    <!-- ═══ FILTRO STAKE % ══════════════════════════════════════════════════ -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-8 col-sm-5 col-md-3">
                    <label class="form-label small text-muted mb-1">Stake %</label>
                    <input class="form-control" type="number" name="pct"
                           step="0.1" min="0.1" max="100"
                           value="@Model.StakePercent.ToString("0.0")" />
                </div>
                <div class="col-4 col-sm-auto">
                    <button class="btn btn-primary w-100" type="submit">Aggiorna</button>
                </div>
                <div class="col-12">
                    <div class="text-muted small">
                        Stake preview = disponibile × @Model.StakePercent.ToString("0.0")%
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- ═══ SUMMARY BAR ══════════════════════════════════════════════════════ -->
    @if (connectedCount > 0)
    {
        <div class="bf-summary-bar mb-3">
            <div class="bf-sb-item">
                <span class="bf-sb-lbl">Account collegati</span>
                <span class="bf-sb-val">
                    <span class="text-success">@connectedCount</span>
                    @if (errorCount > 0)
                    {
                        <span class="text-muted"> / </span>
                
                        <span class="bf-profit-neg">@errorCount errori</span>
                    }
                </span>
            </div>
            <div class="bf-sb-item">
                <span class="bf-sb-lbl">Totale disponibile</span>
                <span class="bf-sb-val bf-price">@totalBalance.ToString("0.00") €</span>
            </div>
            <div class="bf-sb-item">
                <span class="bf-sb-lbl">Stake totale (@Model.StakePercent.ToString("0.0")%)</span>
                <span class="bf-sb-val">@totalStake.ToString("0.00") €</span>
            </div>
            @if (totalExposure != 0)
            {
                <div class="bf-sb-item">
                    <span class="bf-sb-lbl">Esposizione totale</span>
                    <span class="bf-sb-val bf-profit-neg">@totalExposure.ToString("0.00") €</span>
                </div>
            }
        </div>
    }

    <!-- ═══ MOBILE: CARDS ════════════════════════════════════════════════════ -->
    <div class="d-md-none">
        <div class="row g-2">
            @foreach (var r in Model.Rows)
            {
                <div class="col-12 col-sm-6">
                    <div class="card shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div class="fw-bold">@r.DisplayName</div>
                                @if (r.IsConnected)
                                {
                                    <span class="badge bg-success">Collegato</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Errore</span>
                                }
                            </div>

                            @if (r.IsConnected)
                            {
                                <div class="bf-kv">
                                    <div class="bf-kv-row">
                                        <div class="bf-k">Disponibile</div>
                                        <div class="bf-v bf-price">@(r.AvailableToBetBalance?.ToString("0.00") ?? "—") €</div>
                                    </div>
                                    <div class="bf-kv-row">
                                        <div class="bf-k">Stake (@Model.StakePercent.ToString("0.0")%)</div>
                                        <div class="bf-v">@(r.StakePreview?.ToString("0.00") ?? "—") €</div>
                                    </div>
                                    <div class="bf-kv-row">
                                        <div class="bf-k">Esposizione</div>
                                        <div class="bf-v @(r.Exposure < 0 ? "bf-profit-neg" : "")">
                                            @(r.Exposure?.ToString("0.00") ?? "—") €
                                        </div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="text-muted small mt-1">@r.Error</div>
                                @if (r.Error?.Contains("ricollega", StringComparison.OrdinalIgnoreCase) == true ||
                                                        r.Error == "Non collegato")
                                {
                                    <a class="btn btn-sm btn-primary w-100 mt-2" asp-page="/ConnectBetfair">Collega</a>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ═══ DESKTOP: TABELLA ════════════════════════════════════════════════ -->
    <div class="d-none d-md-block">
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Stato</th>
                            <th class="text-end">Disponibile</th>
                            <th class="text-end">Stake (@Model.StakePercent.ToString("0.0")%)</th>
                            <th class="text-end">Esposizione</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Rows)
                        {
                            <tr>
                                <td class="fw-semibold">@r.DisplayName</td>
                                <td>
                                    @if (r.IsConnected)
                                    {
                                        <span class="badge bg-success">Collegato</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@(r.Error ?? "Errore")</span>
                                        @if (r.Error?.Contains("ricollega", StringComparison.OrdinalIgnoreCase) == true ||
                                                                        r.Error == "Non collegato")
                                        {
                                            <a class="btn btn-sm btn-outline-primary ms-2" asp-page="/ConnectBetfair">Collega</a>
                                        }
                                    }
                                </td>
                                <td class="text-end bf-price">
                                    @(r.AvailableToBetBalance.HasValue? r.AvailableToBetBalance.Value.ToString("0.00") + " €" : "—")
                                </td>
                                <td class="text-end">
                                    @(r.StakePreview.HasValue? r.StakePreview.Value.ToString("0.00") + " €" : "—")
                                </td>
                                <td class="text-end @(r.Exposure < 0 ? "bf-profit-neg" : "")">
                                    @(r.Exposure.HasValue? r.Exposure.Value.ToString("0.00") + " €" : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (connectedCount > 1)
                    {
                        <tfoot>
                            <tr class="fw-bold" style="border-top: 1px solid rgba(255,255,255,.18);">
                                <td>Totale</td>
                                <td></td>
                                <td class="text-end bf-price">@totalBalance.ToString("0.00") €</td>
                                <td class="text-end">@totalStake.ToString("0.00") €</td>
                                <td class="text-end @(totalExposure < 0 ? "bf-profit-neg" : "")">@totalExposure.ToString("0.00") €</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a class="btn btn-outline-secondary btn-sm" asp-page="/ConnectBetfair">← Collega account</a>
    </div>

</div>
