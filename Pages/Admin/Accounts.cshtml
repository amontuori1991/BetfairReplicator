@page
@model BetfairReplicator.Pages.Admin.AccountsModel
@{
    ViewData["Title"] = "Gestione Account";
}

<div class="ns-page">

    <!-- ═══ HEADER ═══════════════════════════════════════════════════════ -->
    <div class="ns-header-card">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="ns-title h4 mb-1">Gestione Account</h1>
                <div class="ns-subtitle">Aggiungi, aggiorna o elimina account Betfair</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary btn-sm" asp-page="/Index">Home</a>
                <form method="post" asp-page-handler="Logout" class="m-0">
                    <button class="btn btn-outline-secondary btn-sm">Logout</button>
                </form>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div class="alert alert-success">@Model.Success</div>
    }

    <!-- ═══ FORM AGGIUNGI / AGGIORNA ═════════════════════════════════════ -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="fw-semibold mb-1">Aggiungi / Aggiorna Account</div>
            <div class="text-muted small mb-3">Puoi caricare il file .p12/.pfx oppure incollare Base64.</div>

            <form method="post" asp-page-handler="Upsert" enctype="multipart/form-data">
                <div class="row g-3">

                    <div class="col-12 col-md-4">
                        <label class="form-label small text-muted mb-1">DisplayName (chiave)</label>
                        <input class="form-control" name="DisplayName" required placeholder="Es: Alex, Luca…" />
                    </div>

                    <div class="col-12 col-md-8">
                        <label class="form-label small text-muted mb-1">AppKeyDelayed (1.0-DELAY)</label>
                        <input class="form-control" name="AppKeyDelayed" required />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label small text-muted mb-1">Carica file .p12 (consigliato)</label>
                        <input class="form-control" type="file" name="P12File" accept=".p12,.pfx" />
                        <div class="form-text">Se carichi il file, NON serve incollare Base64.</div>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label small text-muted mb-1">Password P12</label>
                        <input class="form-control" type="password" name="P12Password" required />
                    </div>

                    <div class="col-12">
                        <label class="form-label small text-muted mb-1">Oppure incolla P12Base64 (solo se NON carichi il file)</label>
                        <textarea class="form-control" name="P12Base64" rows="3" placeholder="MIIJ1wIBAzCC…"></textarea>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label small text-muted mb-1">Username Betfair (opzionale)</label>
                        <input class="form-control" name="Username" />
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label small text-muted mb-1">Password Betfair (opzionale)</label>
                        <input class="form-control" type="password" name="Password" />
                    </div>

                </div>
                <button class="btn btn-primary w-100 mt-3">Salva account</button>
            </form>
        </div>
    </div>

    <!-- ═══ LISTA ACCOUNT ════════════════════════════════════════════════ -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="fw-semibold">
                    Account presenti
                    <span class="badge bg-secondary ms-1">@Model.Accounts.Count</span>
                </div>
            </div>

            <!-- MOBILE: cards -->
            <div class="bf-accounts-cards d-md-none">
                <div class="row g-2">
                    @foreach (var a in Model.Accounts)
                    {
                        <div class="col-12 col-sm-6">
                            <div class="bf-account-card">
                                <div class="bf-account-top mb-2">
                                    <div class="bf-account-name">@a.DisplayName</div>
                                </div>

                                <div class="bf-kv mb-2">
                                    <div class="bf-kv-row">
                                        <div class="bf-k">AppKey</div>
                                        <div class="bf-v">
                                            @if (string.IsNullOrWhiteSpace(a.AppKeyDelayed))
                                            {
                                                <span class="badge bg-warning text-dark">mancante</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">ok</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="bf-kv-row">
                                        <div class="bf-k">Certificato P12</div>
                                        <div class="bf-v">
                                            @if (a.HasP12)
                                            {
                                                <span class="badge bg-success">ok</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">mancante</span>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <form method="post" asp-page-handler="Delete" class="m-0">
                                    <input type="hidden" name="displayName" value="@a.DisplayName" />
                                    <button class="btn btn-outline-danger btn-sm w-100"
                                            onclick="return confirm('Eliminare @a.DisplayName?')">
                                        Elimina
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- DESKTOP: tabella -->
            <div class="bf-accounts-table d-none d-md-block">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>DisplayName</th>
                            <th>AppKey</th>
                            <th>Certificato P12</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Accounts)
                        {
                            <tr>
                                <td class="fw-semibold">@a.DisplayName</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(a.AppKeyDelayed))
                                    {
                                        <span class="badge bg-warning text-dark">mancante</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">ok</span>
                                    }
                                </td>
                                <td>
                                    @if (a.HasP12)
                                    {
                                        <span class="badge bg-success">ok</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">mancante</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Delete" class="d-inline">
                                        <input type="hidden" name="displayName" value="@a.DisplayName" />
                                        <button class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Eliminare @a.DisplayName?')">
                                            Elimina
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

</div>
