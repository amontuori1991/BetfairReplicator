@page
@model BetfairReplicator.Pages.StatisticsModel
@{
    ViewData["Title"] = "Statistiche";
    var minDate = "2026-01-30";
    var maxDate = DateTime.UtcNow.ToString("yyyy-MM-dd");
}

<div class="ns-page">
    <div class="ns-header-card">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="ns-title h4 mb-1">Statistiche</h1>
                <div class="ns-subtitle">
                    Storico P&amp;L, ROI, BACK/LAY, Equity
                    @if (!string.IsNullOrWhiteSpace(Model.AccountUsed))
                    {
                        <span class="text-muted">— account: <strong>@Model.AccountUsed</strong></span>
                    }
                </div>
            </div>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Index">Home</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }
    else
    {
        var monthlyJson = System.Text.Json.JsonSerializer.Serialize(
            Model.MonthlyTotal.Select(r => new { label = r.Label, profit = r.Profit, stake = r.Stake, bets = r.Bets, roi = r.RoiPct, roiBankroll = r.RoiBankrollPct })
        );
        var monthlyBackLayJson = System.Text.Json.JsonSerializer.Serialize(new {
            labels = Model.MonthlyTotal.Select(r => r.Label).ToList(),
            back   = Model.MonthlyBack.ToDictionary(r => r.Label, r => r.Profit),
            lay    = Model.MonthlyLay.ToDictionary(r => r.Label, r => r.Profit)
        });
        var equityJson = System.Text.Json.JsonSerializer.Serialize(
            Model.Equity.Select(p => new { date = p.Date, cum = p.CumProfit, dd = p.Drawdown })
        );

        <!-- ═══ FILTRI ═══════════════════════════════════════════════════════ -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <form id="statsForm" method="get" class="row g-2 align-items-end">

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label small text-muted mb-1">Account</label>
                        <select id="accountSelect" class="form-select" name="Account">
                            @foreach (var a in Model.ConnectedAccounts)
                            {
                                <option value="@a" selected="@(string.Equals(a, Model.AccountUsed, StringComparison.OrdinalIgnoreCase))">@a</option>
                            }
                        </select>
                    </div>

                    <div class="col-6 col-sm-6 col-lg-2">
                        <label class="form-label small text-muted mb-1">Da</label>
                        <input type="date" class="form-control" id="fromInput" name="From"
                               min="@minDate" max="@maxDate"
                               value="@Model.FromLocalUsed.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-6 col-sm-6 col-lg-2">
                        <label class="form-label small text-muted mb-1">A</label>
                        <input type="date" class="form-control" id="toInput" name="To"
                               min="@minDate" max="@maxDate"
                               value="@Model.ToLocalUsed.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label small text-muted mb-1">Bankroll iniziale (€)</label>
                        <input type="number" class="form-control" id="bankrollInput" name="Bankroll"
                               step="0.01" min="0" placeholder="es. 500.00"
                               value="@(Model.StartingBankroll > 0 ? Model.StartingBankroll.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : "")" />
                    </div>

                    <div class="col-12 col-sm-6 col-lg-2 d-flex gap-2">
                        <button class="btn btn-primary flex-fill" type="submit">Applica</button>
                        <a class="btn btn-outline-secondary flex-fill"
                           asp-page="/Statistics"
                           asp-route-Account="@Model.AccountUsed"
                           asp-route-From="@minDate"
                           asp-route-To="@maxDate"
                           asp-route-Bankroll="@(Model.StartingBankroll > 0 ? Model.StartingBankroll.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture) : null)">
                            Reset
                        </a>
                    </div>

                </form>
                <div class="text-muted small mt-2">
                    Periodo UTC: <strong>@Model.FromUtcUsed.ToString("yyyy-MM-dd")</strong> → <strong>@Model.ToUtcUsed.ToString("yyyy-MM-dd")</strong>
                </div>
            </div>
        </div>

        <!-- ═══ SUMMARY BAR ══════════════════════════════════════════════════ -->
        @if (Model.TotalBets > 0)
        {
            var winRate = Model.TotalBets == 0 ? 0.0 :
                (Model.MonthlyTotal.Count > 0 ? (double)Model.MonthlyTotal.Count(r => r.Profit > 0) / Model.MonthlyTotal.Count * 100.0 : 0.0);

            <div class="bf-summary-bar mb-3">
                <div class="bf-sb-item">
                    <span class="bf-sb-lbl">P&amp;L totale</span>
                    <span class="bf-sb-val @(Model.TotalProfit >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                        @(Model.TotalProfit >= 0 ? "+" : "")@Model.TotalProfit.ToString("0.00") €
                    </span>
                </div>
                <div class="bf-sb-item">
                    <span class="bf-sb-lbl">Scommesse</span>
                    <span class="bf-sb-val">@Model.TotalBets</span>
                </div>
                <div class="bf-sb-item">
                    <span class="bf-sb-lbl">ROI Stake</span>
                    <span class="bf-sb-val @(Model.TotalRoiPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                        @(Model.TotalRoiPct >= 0 ? "+" : "")@Model.TotalRoiPct.ToString("0.00")%
                    </span>
                </div>
                @if (Model.StartingBankroll > 0)
                {
                    <div class="bf-sb-item">
                        <span class="bf-sb-lbl">ROI Bankroll</span>
                        <span class="bf-sb-val @(Model.TotalRoiBankrollPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                            @(Model.TotalRoiBankrollPct >= 0 ? "+" : "")@Model.TotalRoiBankrollPct.ToString("0.00")%
                        </span>
                    </div>
                }
                <div class="bf-sb-item">
                    <span class="bf-sb-lbl">Max Drawdown</span>
                    <span class="bf-sb-val bf-profit-neg">-@Model.MaxDrawdown.ToString("0.00") €</span>
                </div>
                <div class="bf-sb-item">
                    <span class="bf-sb-lbl">Stake totale</span>
                    <span class="bf-sb-val">@Model.TotalStake.ToString("0.00") €</span>
                </div>
            </div>
        }

        <!-- ═══ KPI CARDS ════════════════════════════════════════════════════ -->
        <div class="row g-3 mb-3">
            <!-- Totale -->
            <div class="col-12 col-md-4">
                <div class="st-kpi">
                    <div class="st-kpi-label">Totale</div>
                    <div class="st-kpi-value @(Model.TotalProfit >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                        @(Model.TotalProfit >= 0 ? "+" : "")@Model.TotalProfit.ToString("0.00") €
                    </div>
                    <div class="st-kpi-grid mt-2">
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">Stake</span>
                            <span class="st-kpi-cval">@Model.TotalStake.ToString("0.00") €</span>
                        </div>
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">ROI Stake</span>
                            <span class="st-kpi-cval @(Model.TotalRoiPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">@Model.TotalRoiPct.ToString("0.00")%</span>
                        </div>
                        @if (Model.StartingBankroll > 0)
                        {
                            <div class="st-kpi-cell">
                                <span class="st-kpi-clbl">ROI Bankroll</span>
                                <span class="st-kpi-cval @(Model.TotalRoiBankrollPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">@Model.TotalRoiBankrollPct.ToString("0.00")%</span>
                            </div>
                        }
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">Bets</span>
                            <span class="st-kpi-cval">@Model.TotalBets</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BACK -->
            <div class="col-12 col-md-4">
                <div class="st-kpi">
                    <div class="st-kpi-label">
                        <span class="bf-side-chip bf-side-back me-1">BACK</span>
                    </div>
                    <div class="st-kpi-value @(Model.BackKpi.Profit >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                        @(Model.BackKpi.Profit >= 0 ? "+" : "")@Model.BackKpi.Profit.ToString("0.00") €
                    </div>
                    <div class="st-kpi-grid mt-2">
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">Stake</span>
                            <span class="st-kpi-cval">@Model.BackKpi.Stake.ToString("0.00") €</span>
                        </div>
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">ROI Stake</span>
                            <span class="st-kpi-cval @(Model.BackKpi.RoiPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">@Model.BackKpi.RoiPct.ToString("0.00")%</span>
                        </div>
                        @if (Model.StartingBankroll > 0)
                        {
                            <div class="st-kpi-cell">
                                <span class="st-kpi-clbl">ROI Bankroll</span>
                                <span class="st-kpi-cval @(Model.BackRoiBankrollPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">@Model.BackRoiBankrollPct.ToString("0.00")%</span>
                            </div>
                        }
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">Bets</span>
                            <span class="st-kpi-cval">@Model.BackKpi.Bets</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- LAY -->
            <div class="col-12 col-md-4">
                <div class="st-kpi">
                    <div class="st-kpi-label">
                        <span class="bf-side-chip bf-side-lay me-1">LAY</span>
                    </div>
                    <div class="st-kpi-value @(Model.LayKpi.Profit >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                        @(Model.LayKpi.Profit >= 0 ? "+" : "")@Model.LayKpi.Profit.ToString("0.00") €
                    </div>
                    <div class="st-kpi-grid mt-2">
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">Stake</span>
                            <span class="st-kpi-cval">@Model.LayKpi.Stake.ToString("0.00") €</span>
                        </div>
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">ROI Stake</span>
                            <span class="st-kpi-cval @(Model.LayKpi.RoiPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">@Model.LayKpi.RoiPct.ToString("0.00")%</span>
                        </div>
                        @if (Model.StartingBankroll > 0)
                        {
                            <div class="st-kpi-cell">
                                <span class="st-kpi-clbl">ROI Bankroll</span>
                                <span class="st-kpi-cval @(Model.LayRoiBankrollPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">@Model.LayRoiBankrollPct.ToString("0.00")%</span>
                            </div>
                        }
                        <div class="st-kpi-cell">
                            <span class="st-kpi-clbl">Bets</span>
                            <span class="st-kpi-cval">@Model.LayKpi.Bets</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ═══ GRAFICI (TABS) ═══════════════════════════════════════════════ -->
        <div class="card shadow-sm">
            <div class="card-body">

                <!-- tab nav -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
                    <div>
                        <div class="fw-semibold">Dashboard grafici</div>
                        <div class="text-muted small">Panoramica visiva del periodo selezionato</div>
                    </div>
                    <ul class="nav nav-pills st-tabs" id="statsTabs" role="tablist">
                        <li class="nav-item"><button class="nav-link active" data-bs-toggle="pill" data-bs-target="#pane-overview" type="button">Panoramica</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-month" type="button">Mensile</button></li>
                        <li class="nav-item"><button class="nav-link" id="tab-day" data-bs-toggle="pill" data-bs-target="#pane-day" type="button">Giornaliero</button></li>
                        <li class="nav-item"><button class="nav-link" data-bs-toggle="pill" data-bs-target="#pane-equity" type="button">Equity</button></li>
                    </ul>
                </div>

                <div class="tab-content" id="statsTabsContent">

                    <!-- PANORAMICA -->
                    <div class="tab-pane fade show active" id="pane-overview" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <div class="st-chart-label mb-2">Profitto mensile</div>
                                <div class="st-chart-wrap">
                                    <canvas id="chartMonthlyProfit" data-rows='@monthlyJson'></canvas>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6">
                                <div class="st-chart-label mb-2">Equity cumulata + Drawdown</div>
                                <div class="st-chart-wrap">
                                    <canvas id="chartEquity" data-rows='@equityJson'></canvas>
                                </div>
                                <div class="text-muted small mt-1">Max Drawdown: <strong class="bf-profit-neg">-@Model.MaxDrawdown.ToString("0.00") €</strong></div>
                            </div>
                        </div>
                    </div>

                    <!-- MENSILE -->
                    <div class="tab-pane fade" id="pane-month" role="tabpanel">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="st-chart-label mb-2">ROI mensile</div>
                                <div class="st-chart-wrap">
                                    <canvas id="chartMonthlyRoi" data-rows='@monthlyJson'></canvas>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="st-chart-label mb-2">BACK vs LAY – profitto mensile</div>
                                <div class="st-chart-wrap">
                                    <canvas id="chartBackLay" data-rows='@monthlyBackLayJson'></canvas>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- GIORNALIERO -->
                    <div class="tab-pane fade" id="pane-day" role="tabpanel">
                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <div>
                                <div class="st-chart-label mb-0">Calendario giornaliero</div>
                                <div class="text-muted small">Verde = profitto · Rosso = perdita</div>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="calPrev">‹</button>
                                <div class="fw-semibold" id="calLabel" style="min-width:130px;text-align:center">—</div>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="calNext">›</button>
                                <button type="button" class="btn btn-outline-secondary btn-sm" id="calToday">Oggi</button>
                            </div>
                        </div>

                        <div class="st-cal">
                            <div class="st-cal-head">
                                <div>L</div><div>M</div><div>M</div><div>G</div><div>V</div><div>S</div><div>D</div>
                            </div>
                            <div class="st-cal-grid" id="calGrid"></div>
                        </div>

                        <div class="row g-2 mt-3">
                            <div class="col-6">
                                <div class="st-kpi st-kpi-sm" id="calProfitCard">
                                    <div class="st-kpi-label">P&amp;L del mese</div>
                                    <div class="st-kpi-value" id="calMonthProfit">0.00 €</div>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="st-kpi st-kpi-sm">
                                    <div class="st-kpi-label">Scommesse</div>
                                    <div class="st-kpi-value" id="calMonthBets">0</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- EQUITY -->
                    <div class="tab-pane fade" id="pane-equity" role="tabpanel">
                        <div class="st-chart-label mb-2">Equity cumulata</div>
                        <div class="st-chart-wrap">
                            <canvas id="chartEquityOnly" data-rows='@equityJson'></canvas>
                        </div>
                    </div>

                </div><!-- /tab-content -->
            </div>
        </div>

        <!-- ═══ TABELLA MENSILE ═══════════════════════════════════════════════ -->
        <div class="card shadow-sm mt-3">
            <div class="card-body">
                <div class="fw-semibold mb-3">Dettaglio mensile</div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Mese</th>
                                <th class="text-end">P&amp;L</th>
                                <th class="text-end">Stake</th>
                                <th class="text-end">ROI Stake</th>
                                @if (Model.StartingBankroll > 0)
                                {
                                    <th class="text-end">ROI Bankroll</th>
                                }
                                <th class="text-end">Bets</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.MonthlyTotal == null || Model.MonthlyTotal.Count == 0)
                            {
                                <tr><td colspan="6" class="text-muted">Nessun dato nel periodo selezionato.</td></tr>
                            }
                            else
                            {
                                @foreach (var r in Model.MonthlyTotal)
                                {
                                    <tr>
                                        <td>@r.Label</td>
                                        <td class="text-end @(r.Profit >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                                            @(r.Profit >= 0 ? "+" : "")@r.Profit.ToString("0.00") €
                                        </td>
                                        <td class="text-end">@r.Stake.ToString("0.00") €</td>
                                        <td class="text-end @(r.RoiPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                                            @r.RoiPct.ToString("0.00")%
                                        </td>
                                        @if (Model.StartingBankroll > 0)
                                        {
                                            <td class="text-end @(r.RoiBankrollPct >= 0 ? "bf-profit-pos" : "bf-profit-neg")">
                                                @r.RoiBankrollPct.ToString("0.00")%
                                            </td>
                                        }
                                        <td class="text-end">@r.Bets</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="text-muted small mt-2">Fonte: listClearedOrders · account: @Model.AccountUsed</div>
            </div>
        </div>

    }
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
<script>
(function () {

    // ── Account select: ricarica bankroll + from + submit ─────────────────────
    const form          = document.getElementById('statsForm');
    const accountSelect = document.getElementById('accountSelect');
    const bankrollInput = document.getElementById('bankrollInput');
    const fromInput     = document.getElementById('fromInput');

    if (form && accountSelect) {
        accountSelect.addEventListener('change', async () => {
            try {
                const acc = accountSelect.value || '';
                const res  = await fetch(`${location.pathname}?handler=Bankroll&account=${encodeURIComponent(acc)}`,
                    { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                const data = await res.json();
                const v = Number(data?.bankroll ?? 0);
                if (bankrollInput) bankrollInput.value = v > 0 ? v.toFixed(2) : '';
                const f = (data?.from ?? '').toString();
                if (f && fromInput) fromInput.value = f;
            } catch { /* fallback silenzioso */ }
            form.submit();
        });
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    function parseCanvasJson(id) {
        const el = document.getElementById(id);
        if (!el) return null;
        try { return JSON.parse(el.getAttribute('data-rows') || 'null'); } catch { return null; }
    }

    function money(x) { return (Number(x) || 0).toFixed(2); }
    function pct(x)   { return (Number(x) || 0).toFixed(2) + '%'; }

    function shortMonthLabel(s) {
        if (!s || s.length < 7) return s;
        return s.substring(5, 7) + '/' + s.substring(2, 4);
    }
    function shortDayLabel(s) {
        if (!s || s.length < 10) return s;
        return s.substring(8, 10) + '/' + s.substring(5, 7);
    }

    const isMobile = window.matchMedia('(max-width: 768px)').matches;

    // ── Chart.js tema dark ────────────────────────────────────────────────────
    Chart.defaults.font.family     = "system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial";
    Chart.defaults.color           = 'rgba(242,246,255,.80)';
    Chart.defaults.scale.grid.color= 'rgba(255,255,255,.06)';
    Chart.defaults.scale.ticks.color = 'rgba(242,246,255,.65)';
    Chart.defaults.plugins.legend.labels.color     = 'rgba(242,246,255,.80)';
    Chart.defaults.plugins.legend.labels.boxWidth  = 10;
    Chart.defaults.plugins.legend.labels.boxHeight = 10;
    Chart.defaults.plugins.tooltip.padding         = 12;
    Chart.defaults.plugins.tooltip.cornerRadius    = 10;
    Chart.defaults.plugins.tooltip.backgroundColor = 'rgba(7,16,31,.92)';
    Chart.defaults.plugins.tooltip.titleColor      = '#ffcc00';
    Chart.defaults.plugins.tooltip.bodyColor       = 'rgba(242,246,255,.90)';
    Chart.defaults.plugins.tooltip.borderColor     = 'rgba(255,255,255,.12)';
    Chart.defaults.plugins.tooltip.borderWidth     = 1;
    Chart.defaults.interaction.mode       = 'index';
    Chart.defaults.interaction.intersect  = false;

    // zero-line plugin
    const zeroLinePlugin = {
        id: 'zeroLine',
        afterDraw(chart) {
            const y = chart.scales?.y;
            if (!y) return;
            const y0 = y.getPixelForValue(0);
            const { ctx, chartArea } = chart;
            if (!chartArea) return;
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(chartArea.left, y0);
            ctx.lineTo(chartArea.right, y0);
            ctx.lineWidth = 1;
            ctx.strokeStyle = 'rgba(255,255,255,.18)';
            ctx.stroke();
            ctx.restore();
        }
    };
    Chart.register(zeroLinePlugin);

    // ── 1. Profitto mensile (barre) ───────────────────────────────────────────
    const monthly = parseCanvasJson('chartMonthlyProfit');
    if (monthly?.length) {
        const labels  = monthly.map(x => x.label);
        const profits = monthly.map(x => x.profit);
        const stakes  = monthly.map(x => x.stake);
        const bets    = monthly.map(x => x.bets);
        const rois    = monthly.map(x => x.roi);
        const colors  = profits.map(p => p >= 0 ? 'rgba(74,222,128,.85)' : 'rgba(248,113,113,.85)');

        new Chart(document.getElementById('chartMonthlyProfit'), {
            type: 'bar',
            data: {
                labels,
                datasets: [{ label: 'Profitto', data: profits, backgroundColor: colors, borderRadius: 8, maxBarThickness: 40 }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            title: (items) => items?.[0]?.label ?? '',
                            label: (ctx)   => ` P&L: ${money(ctx.raw)} €`,
                            afterBody: (items) => {
                                const i = items?.[0]?.dataIndex ?? 0;
                                return [
                                    ` Stake: ${money(stakes[i])} €`,
                                    ` ROI: ${pct(rois[i])}`,
                                    ` ROI Bankroll: ${pct(monthly[i]?.roiBankroll ?? 0)}`,
                                    ` Bets: ${bets[i]}`
                                ];
                            }
                        }
                    }
                },
                scales: {
                    x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 10,
                        callback: (v, i) => shortMonthLabel(labels[i]) } },
                    y: { title: { display: true, text: 'P&L €', color: 'rgba(242,246,255,.55)' } }
                }
            }
        });
    }

    // ── 2. ROI mensile (linea) ────────────────────────────────────────────────
    const monthlyRoi = parseCanvasJson('chartMonthlyRoi');
    if (monthlyRoi?.length) {
        const labels = monthlyRoi.map(x => x.label);
        const rois   = monthlyRoi.map(x => x.roi);

        new Chart(document.getElementById('chartMonthlyRoi'), {
            type: 'line',
            data: {
                labels,
                datasets: [{ label: 'ROI %', data: rois,
                    borderColor: 'rgba(96,165,250,.95)', backgroundColor: 'rgba(96,165,250,.12)',
                    fill: true, tension: 0.25, pointRadius: 2 }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false },
                    tooltip: { callbacks: { label: (ctx) => ` ROI: ${pct(ctx.raw)}` } } },
                scales: {
                    x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 10,
                        callback: (v, i) => shortMonthLabel(labels[i]) } },
                    y: { title: { display: true, text: 'ROI %', color: 'rgba(242,246,255,.55)' } }
                }
            }
        });
    }

    // ── 3. BACK vs LAY ────────────────────────────────────────────────────────
    const backLay = parseCanvasJson('chartBackLay');
    if (backLay?.labels?.length) {
        const labels     = backLay.labels;
        const backProfit = labels.map(l => backLay.back?.[l] ?? 0);
        const layProfit  = labels.map(l => backLay.lay?.[l]  ?? 0);

        new Chart(document.getElementById('chartBackLay'), {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    { label: 'BACK', data: backProfit, backgroundColor: 'rgba(96,165,250,.75)', borderRadius: 8, maxBarThickness: 32 },
                    { label: 'LAY',  data: layProfit,  backgroundColor: 'rgba(255,204,0,.75)',  borderRadius: 8, maxBarThickness: 32 }
                ]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { tooltip: { callbacks: { label: (ctx) => ` ${ctx.dataset.label}: ${money(ctx.raw)} €` } } },
                scales: {
                    x: { ticks: { maxRotation: 0, autoSkip: true, maxTicksLimit: 10,
                        callback: (v, i) => shortMonthLabel(labels[i]) } },
                    y: { title: { display: true, text: 'P&L €', color: 'rgba(242,246,255,.55)' } }
                }
            }
        });
    }

    // ── 4. Equity + Drawdown (overview) ──────────────────────────────────────
    function buildEquityChart(canvasId) {
        const eq = parseCanvasJson(canvasId);
        if (!eq?.length) return;
        const labels = eq.map(x => x.date);
        const cum    = eq.map(x => x.cum);
        const dd     = eq.map(x => x.dd);

        new Chart(document.getElementById(canvasId), {
            data: {
                labels,
                datasets: [
                    { type: 'line', label: 'Equity', data: cum,
                        borderColor: 'rgba(96,165,250,.95)', backgroundColor: 'rgba(96,165,250,.12)',
                        fill: true, tension: 0.25, pointRadius: 0 },
                    { type: 'line', label: 'Drawdown', data: dd,
                        borderColor: 'rgba(248,113,113,.75)', tension: 0.25, pointRadius: 0 }
                ]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { tooltip: { callbacks: { label: (ctx) => ` ${ctx.dataset.label}: ${money(ctx.raw)} €` } } },
                scales: {
                    x: { ticks: { display: !isMobile, maxRotation: 90, minRotation: 90,
                        autoSkip: true, maxTicksLimit: 8, callback: (v, i) => shortDayLabel(labels[i]) } },
                    y: { title: { display: true, text: '€', color: 'rgba(242,246,255,.55)' } }
                }
            }
        });
    }
    buildEquityChart('chartEquity');

    // ── 5. Equity only (tab) ──────────────────────────────────────────────────
    const eqOnly = parseCanvasJson('chartEquityOnly');
    if (eqOnly?.length) {
        const labels = eqOnly.map(x => x.date);
        const cum    = eqOnly.map(x => x.cum);

        new Chart(document.getElementById('chartEquityOnly'), {
            type: 'line',
            data: {
                labels,
                datasets: [{ label: 'Equity', data: cum,
                    borderColor: 'rgba(96,165,250,.95)', backgroundColor: 'rgba(96,165,250,.12)',
                    fill: true, tension: 0.25, pointRadius: 0 }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: { legend: { display: false },
                    tooltip: { callbacks: { label: (ctx) => ` Equity: ${money(ctx.raw)} €` } } },
                scales: {
                    x: { ticks: { display: !isMobile, maxRotation: 90, minRotation: 90,
                        autoSkip: true, maxTicksLimit: 8, callback: (v, i) => shortDayLabel(labels[i]) } },
                    y: { title: { display: true, text: 'P&L cumulato €', color: 'rgba(242,246,255,.55)' } }
                }
            }
        });
    }

    // ── CALENDARIO ────────────────────────────────────────────────────────────
    (function () {
        let calYear, calMonth, calLoaded = false;

        const now = new Date();
        calYear  = now.getFullYear();
        calMonth = now.getMonth() + 1;

        const grid          = document.getElementById('calGrid');
        const label         = document.getElementById('calLabel');
        const btnPrev       = document.getElementById('calPrev');
        const btnNext       = document.getElementById('calNext');
        const btnToday      = document.getElementById('calToday');
        const monthProfitEl = document.getElementById('calMonthProfit');
        const monthBetsEl   = document.getElementById('calMonthBets');
        const profitCard    = document.getElementById('calProfitCard');
        const accSel        = document.getElementById('accountSelect');
        const tabBtn        = document.getElementById('tab-day');

        if (!grid || !label || !accSel) return;

        function moneyEur(x) {
            const v = Number(x || 0);
            return (v >= 0 ? '+' : '') + v.toFixed(2) + ' €';
        }

        async function loadCalendar() {
            const acc = accSel.value || '';
            if (!acc) return;
            label.textContent = '…';

            const url = `${location.pathname}?handler=Calendar&account=${encodeURIComponent(acc)}&year=${calYear}&month=${calMonth}`;
            const res  = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
            const data = await res.json();

            if (!data?.ok) {
                label.textContent = 'Errore';
                grid.innerHTML = `<div class="text-muted small p-2">${data?.error ?? 'Errore caricamento'}</div>`;
                return;
            }
            renderCalendar(data);
            calLoaded = true;
        }

        function renderCalendar(data) {
            label.textContent = data.label || `${data.month}/${data.year}`;

            const mp = Number(data.monthProfit || 0);
            monthProfitEl.textContent = moneyEur(mp);
            monthBetsEl.textContent   = String(data.monthBets || 0);

            monthProfitEl.className = 'st-kpi-value ' + (mp >= 0 ? 'bf-profit-pos' : 'bf-profit-neg');
            profitCard?.classList.remove('bf-profit-pos-card', 'bf-profit-neg-card');
            profitCard?.classList.add(mp >= 0 ? 'bf-profit-pos-card' : 'bf-profit-neg-card');

            const y = data.year, m = data.month;
            const first = new Date(y, m - 1, 1);
            const offset = (first.getDay() + 6) % 7;
            const daysInMonth = new Date(y, m, 0).getDate();
            const prevDays    = new Date(y, m - 1, 0).getDate();
            const days = data.days || [];

            const cells = [];
            for (let i = 0; i < 42; i++) {
                const d = i - offset + 1;
                if (d < 1) {
                    cells.push({ out: true, day: prevDays + d, profit: null });
                } else if (d > daysInMonth) {
                    cells.push({ out: true, day: d - daysInMonth, profit: null });
                } else {
                    const row = days.find(x => Number(x.day) === d) || { profit: 0 };
                    cells.push({ out: false, day: d, profit: Number(row.profit || 0) });
                }
            }

            grid.innerHTML = cells.map(c => {
                if (c.out) return `<div class="st-day st-day-out"><span class="st-day-num">${c.day}</span></div>`;
                const cls = c.profit > 0.0001 ? 'st-day-pos' : (c.profit < -0.0001 ? 'st-day-neg' : 'st-day-zero');
                const amt = (c.profit >= 0 ? '+' : '') + c.profit.toFixed(2);
                return `<div class="st-day ${cls}"><span class="st-day-num">${c.day}</span><span class="st-day-amt">${amt}</span></div>`;
            }).join('');
        }

        btnPrev?.addEventListener('click', () => { calMonth--; if (calMonth < 1) { calMonth = 12; calYear--; } loadCalendar(); });
        btnNext?.addEventListener('click', () => { calMonth++; if (calMonth > 12) { calMonth = 1; calYear++; } loadCalendar(); });
        btnToday?.addEventListener('click', () => { const t = new Date(); calYear = t.getFullYear(); calMonth = t.getMonth()+1; loadCalendar(); });
        tabBtn?.addEventListener('shown.bs.tab', () => { if (!calLoaded) loadCalendar(); });

        loadCalendar();
    })();

})();
</script>
}
