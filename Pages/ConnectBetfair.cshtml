@page
@model BetfairReplicator.Pages.ConnectBetfairModel
@{
    ViewData["Title"] = "Collega Betfair";
}

<div class="ns-page">

    <div class="ns-header-card">
        <div class="d-flex align-items-center justify-content-between">
            <div>
                <h1 class="ns-title h4 mb-1">Collega Betfair</h1>
                <div class="ns-subtitle">Gestione sessioni account</div>
            </div>
            <a class="btn btn-outline-secondary btn-sm" asp-page="/Index">Home</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger">@Model.Error</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.Success))
    {
        <div class="alert alert-success">@Model.Success</div>
    }

    <!-- ═══ SUMMARY BAR ══════════════════════════════════════════════════ -->
    @{
        var connectedCount = Model.Rows.Count(r => r.IsConnected);
        var totalCount = Model.Rows.Count;
    }
    <div class="bf-summary-bar mb-3">
        <div class="bf-sb-item">
            <span class="bf-sb-lbl">Account totali</span>
            <span class="bf-sb-val">@totalCount</span>
        </div>
        <div class="bf-sb-item">
            <span class="bf-sb-lbl">Collegati</span>
            <span class="bf-sb-val @(connectedCount == totalCount ? "bf-profit-pos" : connectedCount == 0 ? "bf-profit-neg" : "")">@connectedCount</span>
        </div>
        <div class="bf-sb-item">
            <span class="bf-sb-lbl">Non collegati</span>
            <span class="bf-sb-val @(totalCount - connectedCount > 0 ? "bf-profit-neg" : "")">@(totalCount - connectedCount)</span>
        </div>
    </div>

    <!-- ═══ MOBILE: cards ════════════════════════════════════════════════ -->
    <div class="d-md-none">
        <div class="row g-2">
            @foreach (var row in Model.Rows)
            {
                <div class="col-12 col-sm-6">
                    <div class="card shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="fw-bold">@row.DisplayName</div>
                                @if (row.IsConnected)
                                {
                                    <span class="badge bg-success">Collegato</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Non collegato</span>
                                }
                            </div>
                            <div class="d-flex gap-2">
                                <form method="get" asp-page="/BetfairLogin" class="flex-fill">
                                    <input type="hidden" name="displayName" value="@row.DisplayName" />
                                    <button type="submit" class="btn btn-primary w-100">
                                        @(row.IsConnected ? "Ricollega" : "Collega")
                                    </button>
                                </form>
                                @if (row.IsConnected)
                                {
                                    <form method="post" asp-page-handler="Disconnect" class="flex-fill">
                                        <input type="hidden" name="displayName" value="@row.DisplayName" />
                                        <button type="submit" class="btn btn-outline-danger w-100">Scollega</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- ═══ DESKTOP: tabella ═════════════════════════════════════════════ -->
    <div class="d-none d-md-block">
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Account</th>
                            <th>Stato</th>
                            <th class="text-end">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="fw-semibold">@row.DisplayName</td>
                                <td>
                                    @if (row.IsConnected)
                                    {
                                        <span class="badge bg-success">Collegato</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Non collegato</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-inline-flex gap-2">
                                        <form method="get" asp-page="/BetfairLogin">
                                            <input type="hidden" name="displayName" value="@row.DisplayName" />
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                @(row.IsConnected ? "Ricollega" : "Collega")
                                            </button>
                                        </form>
                                        @if (row.IsConnected)
                                        {
                                            <form method="post" asp-page-handler="Disconnect">
                                                <input type="hidden" name="displayName" value="@row.DisplayName" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm">Scollega</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
